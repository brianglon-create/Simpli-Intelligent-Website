# Copy to .env.local for `npm run dev`. Set the same keys in the Vercel project.
# Never prefix SUPABASE_SERVICE_ROLE_KEY or RESEND_API_KEY with NEXT_PUBLIC_.

# Project URL from Supabase → Project Settings → API.
# Example: https://abcdefghijklmnopqrst.supabase.co
# Do not include /rest/v1. A bare project ref is also accepted.
# Run supabase/migrations/20261022160000_create_leads.sql before the first signup.
SUPABASE_URL=
# service_role secret (legacy eyJ... JWT, or sb_secret_...). No quotes.
SUPABASE_SERVICE_ROLE_KEY=

# Resend. Both are required before any email is sent.
# EMAIL_FROM must be a verified sender, for example:
# Simpli Intelligent <hello@simpliintelligent.com>
RESEND_API_KEY=
EMAIL_FROM=

# Inbox for every new signup and the 40 / 50 / 90 / 100 founding alerts.
# Falls back to brian@simpliintelligent.com when unset.
LEAD_NOTIFY_EMAIL=

# Optional full postal address for the privacy page and confirmation emails.
# Example: 123 Example Ave, South Bend, IN 46601
# CASL and CAN-SPAM want a street address before commercial email goes out.
POSTAL_ADDRESS=

# Optional. "memory" forces the in-memory store (not durable). Do not use on Vercel.
# Local `npm run dev` already uses memory when Supabase is unset.
LEAD_STORE=
